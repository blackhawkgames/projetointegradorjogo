    - target: {fileID: 4583272806671486518, guid: 0353c764f35406e47bc10f638fde65f1,
        type: 3}
      propertyPath: Consequences.m_PersistentCalls.m_Calls.Array.data[0].m_Arguments.m_StringArgument
      value: "Golpes de \"dinheiro esquecido\" usam a promessa de valores a receber
        para obter dados pessoais, banc\xE1rios ou cobrar taxas antecipadas. Institui\xE7\xF5es
        oficiais nunca solicitam esse tipo de informa\xE7\xE3o por WhatsApp ou telefone
        a partir de um an\xFAncio de rua. Consultas de valores a receber devem ser
        feitas apenas em canais oficiais, como o site do Banco Central"
      objectReference: {fileID: 0}
    - target: {fileID: 4583272806671486518, guid: 0353c764f35406e47bc10f638fde65f1,
        type: 3}
      propertyPath: WinConsequences.m_PersistentCalls.m_Calls.Array.data[0].m_Arguments.m_StringArgument
      value: "Voc\xEA percebeu que institui\xE7\xF5es financeiras n\xE3o avisam sobre
        valores a receber por cartazes de rua ou WhatsApp pessoal. Encerrar o contato
        foi a atitude correta."
      objectReference: {fileID: 0}
